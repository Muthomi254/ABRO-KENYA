# # GEMINI_API_KEY: Required for Gemini AI API calls.
# # AI Studio automatically injects this at runtime from user secrets.
# # Users configure this via the Secrets panel in the AI Studio UI.
# GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# # APP_URL: The URL where this applet is hosted.
# # AI Studio automatically injects this at runtime with the Cloud Run service URL.
# # Used for self-referential links, OAuth callbacks, and API endpoints.
# APP_URL="YOUR_APP_URL"

# # ADMIN_PASSWORD: Secure key required for Stock and Rules admin modifications.
# ADMIN_PASSWORD="CHANGE_ME_TO_A_STRONG_RANDOM_PASSWORD"

# # ALLOW_SANDBOX_IFRAME: Set to "true" to allow embedding in other sites even in standalone mode.
# ALLOW_SANDBOX_IFRAME="false"

# # Cloudinary Storage Configuration for Admin Product Images.
# CLOUDINARY_CLOUD_NAME="muthomi254"
# CLOUDINARY_API_KEY="595797988235321"
# CLOUDINARY_API_SECRET="YOUR_CLOUDINARY_API_SECRET"
# CLOUDINARY_UPLOAD_PRESET="Abro_kenya"
# CLOUDINARY_FOLDER="AbroKenya"

# # FIREBASE_SERVICE_ACCOUNT_JSON: Optional JSON string for server-side Firebase Admin SDK (e.g. on Vercel)
# FIREBASE_SERVICE_ACCOUNT_JSON=""
